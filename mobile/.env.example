# Copy to .env.local and fill in. Both values are public by design (never put the
# secret / service-role key in the app).
#
# Local Supabase (npx supabase start, from the project root):
#   Physical phone (Expo Go) -> your computer's Wi-Fi IP, e.g. http://192.168.1.3:55421
#   Android emulator         -> http://10.0.2.2:55421
# Hosted Supabase            -> https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.3:55421
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
