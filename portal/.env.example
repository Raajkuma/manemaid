# Copy to .env.local. Both values are public by design: NEVER put the Supabase
# secret / service-role key in the portal (anyone can read a web page's code).
#
# Local Supabase (npx supabase start, from the project root):
VITE_SUPABASE_URL=http://127.0.0.1:55421
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Optional: shown as "Open Supabase dashboard" in the developer console.
# Local: http://127.0.0.1:55423  ·  Hosted: https://supabase.com/dashboard/project/<project-ref>
VITE_SUPABASE_DASHBOARD_URL=http://127.0.0.1:55423
